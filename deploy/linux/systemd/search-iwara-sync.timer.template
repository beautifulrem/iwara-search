# __MANAGED_MARKER__
[Unit]
Description=Run Search Iwara incremental sync every __SYNC_INTERVAL_HOURS__ hour(s)

[Timer]
OnCalendar=__SYNC_ON_CALENDAR__
RandomizedDelaySec=10min
AccuracySec=1min
# Catch up on a missed run after downtime (works with OnCalendar=).
Persistent=true
Unit=search-iwara-sync.service

[Install]
WantedBy=timers.target
