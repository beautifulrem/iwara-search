    server_tokens off;
    client_max_body_size 16k;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml;

    limit_req_status 429;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
    proxy_redirect off;
__HSTS_HEADER__
    # Static assets are fingerprinted with ?v=<hash>, so they can be cached
    # for a year and served straight from disk without touching the app.
    location /static/ {
        alias __APP_DIR__/search_iwara/static/;
        access_log off;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
__HSTS_HEADER_NESTED__    }

    # Prometheus metrics: loopback only (scrape from the host or via a tunnel).
    location = /metrics {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://__UPSTREAM__;
    }

    location ~ ^/(healthz|readyz)$ {
        access_log off;
        proxy_pass http://__UPSTREAM__;
    }

    location /api/ {
        limit_req zone=search_iwara_api burst=40 nodelay;
        proxy_pass http://__UPSTREAM__;
    }

    location / {
        limit_req zone=search_iwara_pages burst=20 nodelay;
        proxy_pass http://__UPSTREAM__;
    }
