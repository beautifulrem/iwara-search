    server_tokens off;
    client_max_body_size 16k;
    charset utf-8;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/manifest+json application/xml image/svg+xml;

    limit_req_status 429;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_connect_timeout 10s;
    proxy_read_timeout 60s;
    proxy_redirect off;
__HSTS_HEADER__
    # Static assets fingerprinted with ?v=<hash> get 1y immutable caching; unversioned
    # files (manifest.webmanifest, favicon.svg) get a 1h TTL via $search_iwara_static_cache.
    location /static/ {
        alias __APP_DIR__/search_iwara/static/;
        access_log off;
        add_header Cache-Control $search_iwara_static_cache always;
        add_header Content-Security-Policy "default-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Resource-Policy "same-origin" always;
__HSTS_HEADER_NESTED__    }

    # Prometheus metrics: loopback only (scrape from the host or via a tunnel).
    location = /metrics {
        allow 127.0.0.1;
        allow ::1;
        deny all;
        proxy_pass http://__UPSTREAM__;
    }

    location ~ ^/(healthz|readyz)$ {
        access_log off;
        proxy_pass http://__UPSTREAM__;
    }

    location /api/ {
        limit_req zone=search_iwara_api burst=40 nodelay;
        proxy_pass http://__UPSTREAM__;
    }

    location / {
        limit_req zone=search_iwara_pages burst=20 nodelay;
        proxy_pass http://__UPSTREAM__;
    }
