APP_DIR=/opt/search-iwara
UV_BIN=/usr/local/bin/uv
SEARCH_IWARA_DB=/opt/search-iwara/data/oreno3d.sqlite3

# Keep 127.0.0.1 when nginx is handling public traffic.
SEARCH_IWARA_HOST=127.0.0.1
SEARCH_IWARA_PORT=8000
SEARCH_IWARA_SYNC_HOURS=6
SEARCH_IWARA_DEPLOY_MODE=local
SEARCH_IWARA_SERVICE_USER=searchiwara
SEARCH_IWARA_SERVICE_GROUP=searchiwara
SEARCH_IWARA_SERVER_NAME=
SEARCH_IWARA_TLS_MODE=http
SEARCH_IWARA_TLS_CERT_FILE=
SEARCH_IWARA_TLS_KEY_FILE=

# sync latest options
SEARCH_IWARA_STABLE_PAGES=3
SEARCH_IWARA_MAX_PAGES=
SEARCH_IWARA_REQUEST_CONCURRENCY=12
SEARCH_IWARA_REQUEST_DELAY_MS=50
SEARCH_IWARA_LIST_PREFETCH_PAGES=8
SEARCH_IWARA_DETAIL_BATCH_SIZE=96
