# Example of /etc/search-iwara/search-iwara.env.
# Normally generated by `sudo ./deploy/linux/manage.py` (or install.sh), which
# is the single source of truth for these fields. Empty optional values are
# left commented out so they are not exported as empty strings.
APP_DIR=/opt/search-iwara
UV_BIN=/usr/local/bin/uv
SEARCH_IWARA_DB=/opt/search-iwara/data/oreno3d.sqlite3

# Keep 127.0.0.1 when nginx handles public traffic.
SEARCH_IWARA_HOST=127.0.0.1
SEARCH_IWARA_PORT=8000

# Crawler politeness: concurrent requests and global requests/second.
SEARCH_IWARA_REQUEST_CONCURRENCY=4
SEARCH_IWARA_REQUEST_RATE=2.0
SEARCH_IWARA_LIST_PREFETCH_PAGES=4
# SEARCH_IWARA_PROXY=socks5://127.0.0.1:1080
SEARCH_IWARA_TRUST_ENV=true

SEARCH_IWARA_LOG_FORMAT=json
SEARCH_IWARA_LOG_LEVEL=INFO

SEARCH_IWARA_BACKUP_DIR=/opt/search-iwara/data/backups
SEARCH_IWARA_BACKUP_KEEP=7

# /metrics: loopback-only by default. When the app binds a public address (deploy mode
# "public") it is served only with this bearer token; manage.py generates one there.
# SEARCH_IWARA_METRICS_TOKEN=change-me-to-a-long-random-token
# OpenAPI docs at /api/docs (off by default).
SEARCH_IWARA_API_DOCS_ENABLED=false

# sync latest options (mapped to CLI flags by run-sync-latest.sh)
SEARCH_IWARA_STABLE_PAGES=3
# SEARCH_IWARA_MAX_PAGES=

# Failure alerts: always logged to the journal; also POSTed here when set.
# SEARCH_IWARA_ALERT_WEBHOOK=https://ntfy.sh/your-topic

# Deployment bookkeeping (read by manage.py only)
SEARCH_IWARA_SYNC_HOURS=6
SEARCH_IWARA_DEPLOY_MODE=nginx
SEARCH_IWARA_SERVICE_USER=searchiwara
SEARCH_IWARA_SERVICE_GROUP=searchiwara
SEARCH_IWARA_SERVER_NAME=search.example.com
SEARCH_IWARA_TLS_MODE=https
SEARCH_IWARA_TLS_CERT_FILE=/etc/letsencrypt/live/search.example.com/fullchain.pem
SEARCH_IWARA_TLS_KEY_FILE=/etc/letsencrypt/live/search.example.com/privkey.pem
SEARCH_IWARA_HSTS_MAX_AGE=63072000
